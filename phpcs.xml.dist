<?xml version="1.0"?>
<ruleset name="WordPress Theme Coding Standards">
	<description>A custom set of code standard rules to check for WordPress themes.</description>

	<file>./themes/wbs</file>

	<ini name="error_reporting" value="E_ALL &#38; ~E_DEPRECATED" />
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".cache/phpcs.json"/>
	<arg name="colors"/>
	<arg value="ps"/>
	<ini name="memory_limit" value="256M"/>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<config name="testVersion" value="8.3-"/>
	<config name="minimum_supported_wp_version" value="7.0"/>

	<rule ref="WordPress-Extra" />
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="VariableAnalysis">
		<properties>
			<!-- WP がブロック render.php / get_template_part() に注入する変数を未定義扱いしない -->
			<property name="validUndefinedVariableNames" value="attributes content block args"/>
		</properties>
	</rule>

	<!-- テーマのテキストドメインを i18n 関数に強制 -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wbs"/>
			</property>
		</properties>
	</rule>
</ruleset>
