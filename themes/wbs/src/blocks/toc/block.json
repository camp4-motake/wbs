{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wbs/toc",
	"version": "1.0.0",
	"title": "目次",
	"category": "wbs-theme-blocks",
	"icon": "list-view",
	"description": "投稿内の見出しから目次を自動生成します",
	"example": {},
	"supports": {
		"html": false,
		"multiple": false,
		"interactivity": true,
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": true
		},
		"color": {
			"background": true,
			"text": false,
			"link": false
		}
	},
	"attributes": {
		"minLevel": {
			"type": "number",
			"default": 2
		},
		"maxLevel": {
			"type": "number",
			"default": 3
		},
		"backgroundColor": {
			"type": "string",
			"default": "bg-fill"
		}
	},
	"textdomain": "wbs",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
