{
	"name": "wbs-theme",
	"description": "Site Block theme",
	"version": "0.1.0",
	"author": "CAMP4 inc.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"dev": "rimraf build/* && node ./bin/build-images.mjs && wp-scripts start --experimental-modules --webpack-copy-php --stats=minimal",
		"build": "rimraf build/* && wp-scripts build --experimental-modules --webpack-copy-php --stats=minimal && node ./bin/build-images.mjs --production",
		"build:images": "node ./bin/build-images.mjs --production",
		"watch:images": "node ./bin/build-images.mjs --watch",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "npm run build && wp-scripts plugin-zip --root-folder='wbs'"
	},
	"dependencies": {
		"@acab/reset.css": "0.11.0",
		"@wordpress/scripts": "35.0.0",
		"cssnano": "8.0.2",
		"embla-carousel": "9.0.0-rc02",
		"embla-carousel-class-names": "9.0.0-rc02",
		"postcss": "8.5.23",
		"postcss-easy-import": "4.0.0",
		"postcss-preset-env": "11.3.2",
		"postcss-url": "10.1.4",
		"rimraf": "6.1.3",
		"sharp": "0.35.3",
		"svgo": "4.0.2"
	},
	"devDependencies": {
		"@types/wordpress__block-editor": "15.0.6",
		"@wordpress/block-editor": "17.1.0",
		"@wordpress/blocks": "16.0.0",
		"@wordpress/components": "40.1.0",
		"@wordpress/compose": "8.8.0",
		"@wordpress/core-data": "8.0.0",
		"@wordpress/data": "10.55.0",
		"@wordpress/dom-ready": "4.55.0",
		"@wordpress/editor": "15.0.0",
		"@wordpress/element": "8.7.0",
		"@wordpress/hooks": "4.55.0",
		"@wordpress/i18n": "6.28.0",
		"@wordpress/icons": "16.0.0",
		"@wordpress/interactivity": "6.55.0",
		"@wordpress/plugins": "7.55.0",
		"@wordpress/rich-text": "7.55.0",
		"@wordpress/server-side-render": "6.31.0",
		"chokidar": "5.0.0"
	},
	"files": [
		"build",
		"inc",
		"partials",
		"parts",
		"patterns",
		"static",
		"templates",
		"functions.php",
		"screenshot.png",
		"style.css",
		"theme.json"
	]
}
